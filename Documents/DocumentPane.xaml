<UserControl x:Class="HB.Documents.DocumentPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:HB.Documents">
    <DockPanel>
        <!-- Current file and the buttons that rearrange the column -->
        <DockPanel DockPanel.Dock="Top" Margin="8,8,8,6">
            <Button x:Name="BrowserToggleButton" DockPanel.Dock="Right" FontSize="11" Padding="8,3"
                    VerticalAlignment="Center" Click="BrowserToggle_Click" />
            <Button x:Name="PopOutButton" DockPanel.Dock="Right" FontSize="11" Padding="8,3" Margin="0,0,8,0"
                    VerticalAlignment="Center" Click="PopOut_Click"
                    ToolTip="Show the output in its own window, or bring it back here" />
            <Button x:Name="CompileButton" DockPanel.Dock="Right" FontSize="11" Padding="8,3" Margin="0,0,8,0"
                    VerticalAlignment="Center" Content="Compile" Click="Compile_Click"
                    ToolTip="Build the PDF now (it is also built automatically after each change)" />
            <TextBlock x:Name="StatusText" DockPanel.Dock="Right" FontSize="11" Opacity="0.6"
                       VerticalAlignment="Center" Margin="12,0" />
            <TextBlock x:Name="FileNameText" FontWeight="SemiBold" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <!-- File browser -->
        <DockPanel x:Name="BrowserPanel" DockPanel.Dock="Top" Height="230" Margin="8,0,8,8">
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                <Button Content="New file…" Click="NewFile_Click" ToolTip="Create a file" />
                <Button Content="Open other…" Margin="8,0,0,0" Click="OpenOther_Click"
                        ToolTip="Open a file that is outside this workspace folder" />
                <Button Content="Refresh" Margin="8,0,0,0" Click="Refresh_Click"
                        ToolTip="Read the folder again" />
            </StackPanel>
            <TreeView x:Name="FileTree" SelectedItemChanged="FileTree_SelectedItemChanged"
                      MouseDoubleClick="FileTree_MouseDoubleClick" />
        </DockPanel>

        <!-- Editor on top, output below (or in its own window) -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="80" />
                <RowDefinition Height="Auto" />
                <RowDefinition x:Name="SplitterRow" Height="5" />
                <RowDefinition x:Name="PreviewRow" Height="*" />
            </Grid.RowDefinitions>
            <TextBox x:Name="Editor" Grid.Row="0" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas" FontSize="13"
                     Padding="10" BorderThickness="0" VerticalContentAlignment="Top" SpellCheck.IsEnabled="False"
                     TextChanged="Editor_TextChanged" PreviewKeyDown="Editor_PreviewKeyDown" />
            <TextBlock x:Name="NoFileHint" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Opacity="0.6" TextWrapping="Wrap" Margin="20"
                       Text="Select a file in the file browser, or create a new one, to start editing." />
            <!-- LaTeX compilation errors -->
            <TextBox x:Name="ErrorBox" Grid.Row="1" IsReadOnly="True" MaxHeight="130" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                     Foreground="#FF8B8B" Padding="10,6" BorderThickness="0" Visibility="Collapsed" />
            <GridSplitter Grid.Row="2" HorizontalAlignment="Stretch" Background="#22FFFFFF" />
            <Grid Grid.Row="3" Background="#161616">
                <local:PreviewView x:Name="DockedPreview" />
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
