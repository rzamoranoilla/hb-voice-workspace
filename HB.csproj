<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The Windows 10 SDK version gives access to the Windows text-to-speech voices -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- Self-contained so the app runs without a machine-wide .NET runtime -->
    <SelfContained>true</SelfContained>
    <AssemblyTitle>HB Voice Workspace</AssemblyTitle>
    <!-- Icon of the exe, and so of every window and the taskbar button (built from Assets\logo.png) -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>HB Voice Workspace</Product>
    <Company>Zamoilla</Company>
    <Authors>Raul Zamorano-Illanes</Authors>
    <Copyright>Copyright 2026 Zamoilla</Copyright>
    <!-- English .NET resources only: the other languages would add 13 folders to the install -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Concentus" Version="2.2.2" />
    <PackageReference Include="Markdig" Version="0.*" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.*" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="NAudio.WinMM" Version="2.2.1" />
    <PackageReference Include="Whisper.net" Version="1.8.*" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.8.*" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
