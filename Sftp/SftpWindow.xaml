<Window x:Class="HB.Sftp.SftpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:HB.Sftp"
        Title="SFTP" Width="1100" Height="680" MinWidth="720" MinHeight="420"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="10">
        <!-- Connection state: shown while connecting and when it failed -->
        <Border x:Name="ConnectBar" DockPanel.Dock="Top" Background="#1C1C1C" BorderBrush="#333333" BorderThickness="1"
                CornerRadius="3" Padding="10,7" Margin="0,0,0,8">
            <DockPanel>
                <Button x:Name="RetryButton" DockPanel.Dock="Right" Content="Try again" Padding="10,3" Margin="12,0,0,0"
                        Visibility="Collapsed" Click="Retry_Click" />
                <TextBlock x:Name="ConnectText" VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>
        </Border>

        <!-- Transfer in progress -->
        <Border x:Name="TransferBar" DockPanel.Dock="Bottom" Background="#1C1C1C" BorderBrush="#333333" BorderThickness="1"
                CornerRadius="3" Padding="10,7" Margin="0,8,0,0" Visibility="Collapsed">
            <DockPanel>
                <Button x:Name="CancelButton" DockPanel.Dock="Right" Content="Cancel" Padding="10,3" Margin="12,0,0,0"
                        Click="Cancel_Click" />
                <TextBlock x:Name="TransferText" DockPanel.Dock="Top" FontSize="12" TextTrimming="CharacterEllipsis"
                           Margin="0,0,0,5" />
                <ProgressBar x:Name="TransferProgress" Height="4" Minimum="0" Maximum="1" Foreground="#46A758"
                             Background="#262626" BorderThickness="0" />
            </DockPanel>
        </Border>
        <TextBlock x:Name="HintText" DockPanel.Dock="Bottom" FontSize="11" Opacity="0.55" Margin="0,8,0,0" TextWrapping="Wrap"
                   Text="Double-click a folder to open it. Drag files or folders from one side to the other (or from Explorer) to copy them; Ctrl and Shift select several. Double-click or Enter on a file copies it to the other side." />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <local:FilePane x:Name="LocalPane" Grid.Column="0" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                <Button Content="→" FontSize="16" Padding="10,4" Click="Upload_Click"
                        ToolTip="Copy the selected files of this computer to the device" />
                <Button Content="←" FontSize="16" Padding="10,4" Margin="0,8,0,0" Click="Download_Click"
                        ToolTip="Copy the selected files of the device to this computer" />
            </StackPanel>
            <local:FilePane x:Name="RemotePane" Grid.Column="2" />
        </Grid>
    </DockPanel>
</Window>
