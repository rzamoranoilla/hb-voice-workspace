<Window x:Class="HB.NewWorkspaceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New workspace" Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock Text="Template" FontSize="11" Opacity="0.7" Margin="0,0,0,4" />
        <ListBox x:Name="TemplateList" HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,2">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Description}" FontSize="11" Opacity="0.7" TextWrapping="Wrap" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Text="Folder" FontSize="11" Opacity="0.7" Margin="0,14,0,4" />
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="Browse…" Margin="8,0,0,0" Click="Browse_Click" />
            <TextBox x:Name="FolderBox" TextChanged="FolderBox_TextChanged" />
        </DockPanel>
        <TextBlock FontSize="11" Opacity="0.6" Margin="0,4,0,0" TextWrapping="Wrap"
                   Text="Terminals start in this folder and the transcription is saved in it." />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="OpenButton" Content="Open workspace" IsDefault="True" IsEnabled="False"
                    Padding="14,6" Click="Open_Click" />
            <Button Content="Cancel" IsCancel="True" Padding="14,6" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
