<UserControl x:Class="HB.Sftp.FilePane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <!-- Title, then the path with the buttons around it -->
        <TextBlock x:Name="TitleText" DockPanel.Dock="Top" FontWeight="SemiBold" Margin="0,0,0,6"
                   TextTrimming="CharacterEllipsis" />
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <Button DockPanel.Dock="Left" Content="↑" Padding="8,3" Margin="0,0,6,0" Click="Up_Click"
                    ToolTip="Parent folder (Backspace)" />
            <Button DockPanel.Dock="Right" Content="↻" Padding="8,3" Margin="6,0,0,0" Click="Refresh_Click"
                    ToolTip="Read the folder again (F5)" />
            <TextBox x:Name="PathBox" Padding="6,3" FontSize="12" KeyDown="PathBox_KeyDown"
                     ToolTip="Type a path and press Enter" />
        </DockPanel>
        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" FontSize="11" Opacity="0.7" Margin="0,5,0,0"
                   TextTrimming="CharacterEllipsis" />

        <ListView x:Name="List" SelectionMode="Extended" AllowDrop="True" BorderThickness="1" BorderBrush="#333333"
                  ScrollViewer.CanContentScroll="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  SizeChanged="List_SizeChanged"
                  PreviewMouseLeftButtonDown="List_PreviewMouseLeftButtonDown"
                  PreviewMouseLeftButtonUp="List_PreviewMouseLeftButtonUp"
                  MouseMove="List_MouseMove" MouseDoubleClick="List_MouseDoubleClick" KeyDown="List_KeyDown"
                  SelectionChanged="List_SelectionChanged"
                  DragEnter="List_DragOver" DragOver="List_DragOver" DragLeave="List_DragLeave" Drop="List_Drop">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="4,2" />
                    <Style.Triggers>
                        <!-- The folder a drag is over -->
                        <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                            <Setter Property="Background" Value="#3046A758" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
                <GridView>
                    <GridViewColumn x:Name="NameColumn" Header="Name" Width="300">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Entry.Glyph}" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding Entry.Name}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Size" Width="90">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Entry.SizeText}" TextAlignment="Right" Opacity="0.8" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Modified" Width="130" DisplayMemberBinding="{Binding Entry.ModifiedText}" />
                </GridView>
            </ListView.View>
            <ListView.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Open" Click="Open_Click" />
                    <MenuItem x:Name="TransferMenuItem" Header="Transfer" Click="Transfer_Click" />
                    <Separator />
                    <MenuItem Header="New folder…" Click="NewFolder_Click" />
                    <MenuItem Header="Rename…" InputGestureText="F2" Click="Rename_Click" />
                    <MenuItem Header="Delete" InputGestureText="Del" Click="Delete_Click" />
                    <Separator />
                    <MenuItem Header="Refresh" InputGestureText="F5" Click="Refresh_Click" />
                </ContextMenu>
            </ListView.ContextMenu>
        </ListView>
    </DockPanel>
</UserControl>
