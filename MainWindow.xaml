<Window x:Class="HB.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:documents="clr-namespace:HB.Documents"
        Title="HB Voice Workspace" Width="1400" Height="820" MinWidth="900" MinHeight="500"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="ColumnTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Read-only text that looks like a label but can be selected with the mouse (and so copied) -->
        <Style x:Key="SelectableText" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="IsReadOnlyCaretVisible" Value="False" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="IBeam" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="7,2" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </Window.Resources>

    <!-- The side columns have fixed widths (the splitters change them); the middle one takes the rest.
         RootGrid_SizeChanged narrows the side columns when the window becomes too narrow for all three. -->
    <Grid x:Name="RootGrid" SizeChanged="RootGrid_SizeChanged">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" MinWidth="140" />
            <ColumnDefinition Width="5" />
            <ColumnDefinition Width="*" MinWidth="300" />
            <ColumnDefinition Width="5" />
            <ColumnDefinition Width="380" MinWidth="260" />
        </Grid.ColumnDefinitions>

        <!-- Column 1: workspaces -->
        <DockPanel x:Name="WorkspacesColumn" Grid.Column="0" Margin="10,10,6,10">
            <DockPanel DockPanel.Dock="Bottom" Margin="2,8,0,0">
                <Button DockPanel.Dock="Right" Content="Log out" FontSize="11" Padding="8,3" Click="Logout_Click"
                        ToolTip="Close this session and log in as another user" />
                <TextBlock x:Name="UserText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Opacity="0.8" />
            </DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="2,0,0,8">
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="＋"
                        ToolTip="Open a folder as a workspace" Click="AddWorkspace_Click" />
                <Image DockPanel.Dock="Left" Source="/Assets/logo.png" Width="18" Height="18" Margin="0,0,8,0"
                       VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Style="{StaticResource ColumnTitle}" Text="WORKSPACES" />
            </DockPanel>
            <!-- Ctrl+F in this column: filters the list by name -->
            <TextBox x:Name="WorkspaceFilterBox" DockPanel.Dock="Top" Visibility="Collapsed" Margin="2,0,0,8"
                     Padding="6,3" FontSize="12" TextChanged="WorkspaceFilter_TextChanged"
                     PreviewKeyDown="WorkspaceFilter_PreviewKeyDown"
                     ToolTip="Part of a workspace name. Enter selects the first match, Esc clears and closes." />
            <Grid>
                <ListBox x:Name="WorkspaceList" ScrollViewer.CanContentScroll="False" SelectionChanged="WorkspaceList_SelectionChanged"
                         HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel ToolTip="{Binding Path}">
                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="✕"
                                        FontSize="10" ToolTip="Close workspace (files are kept)"
                                        Click="RemoveWorkspace_Click" />
                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="⏹"
                                        FontSize="10" Foreground="#E5484D"
                                        ToolTip="Stop: release this workspace's terminals and preview (files are kept)"
                                        Visibility="{Binding CanStop, Converter={StaticResource BoolToVisibility}}"
                                        Click="StopWorkspace_Click" />
                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="▶"
                                        FontSize="10" Foreground="#46A758"
                                        ToolTip="Start: load this workspace's resources"
                                        Visibility="{Binding CanStart, Converter={StaticResource BoolToVisibility}}"
                                        Click="StartWorkspace_Click" />
                                <Ellipse DockPanel.Dock="Left" Width="9" Height="9" Margin="2,0,8,0"
                                         VerticalAlignment="Center" Fill="{Binding StateBrush}"
                                         ToolTip="{Binding StateText}" />
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="NoWorkspacesHint" TextWrapping="Wrap" Opacity="0.6" Margin="4,8"
                           Text="No workspaces yet. Press ＋ to open a folder." />
            </Grid>
        </DockPanel>

        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#22FFFFFF" />

        <!-- Column 2: the workspace's environment (terminals or document editor), with a banner
             while it is stopped and a loading overlay while its resources start -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border x:Name="StoppedBanner" Grid.Row="0" Background="#2A1A1B" BorderBrush="#5A2A2D" BorderThickness="0,0,0,1"
                    Padding="12,8" Visibility="Collapsed">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="▶  Start" Padding="12,4" Click="StartCurrent_Click"
                            ToolTip="Load this workspace's resources" />
                    <Ellipse DockPanel.Dock="Left" Width="9" Height="9" Fill="#E5484D" Margin="0,0,10,0"
                             VerticalAlignment="Center" />
                    <TextBlock x:Name="StoppedBannerText" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0" />
                </DockPanel>
            </Border>

            <Grid Grid.Row="1">
        <DockPanel x:Name="TerminalColumn">
            <DockPanel DockPanel.Dock="Top" Margin="6,6,6,4" LastChildFill="False">
                <Button x:Name="SshToggleButton" DockPanel.Dock="Right" FontSize="11" Padding="8,3"
                        VerticalAlignment="Center" Visibility="Collapsed" Click="SshToggle_Click" />
                <ListBox x:Name="TabStrip" DockPanel.Dock="Left" SelectionChanged="TabStrip_SelectionChanged"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Background="Transparent">
                                <StackPanel.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Rename" Click="RenameTab_Click" />
                                        <MenuItem Header="Close tab" Click="CloseTab_Click" />
                                    </ContextMenu>
                                </StackPanel.ContextMenu>
                                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" Margin="0,0,6,0"
                                           ToolTip="Right-click or double-click to rename"
                                           MouseLeftButtonDown="TabTitle_MouseDown">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBox MinWidth="110" MaxLength="40" Margin="0,0,6,0" VerticalAlignment="Center"
                                         Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}"
                                         IsVisibleChanged="TabRename_IsVisibleChanged" KeyDown="TabRename_KeyDown"
                                         LostFocus="TabRename_LostFocus" />
                                <Button Style="{StaticResource IconButton}" Content="✕" FontSize="10"
                                        ToolTip="Close tab" Click="CloseTab_Click" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Button x:Name="AddTabButton" DockPanel.Dock="Left" Style="{StaticResource IconButton}"
                        Content="＋" ToolTip="New PowerShell tab" VerticalAlignment="Center" Margin="4,0,0,0"
                        Click="AddTab_Click" />
            </DockPanel>
            <!-- SSH template: connection details for the selected terminal -->
            <StackPanel x:Name="SshBar" DockPanel.Dock="Top" Margin="8,2,8,8" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.3*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="1.6*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Column="0" Text="Name" FontSize="11" Opacity="0.7" Margin="0,0,0,3" />
                    <TextBlock Grid.Column="2" Text="Host or IP" FontSize="11" Opacity="0.7" Margin="0,0,0,3" />
                    <TextBlock Grid.Column="4" Text="Port" FontSize="11" Opacity="0.7" Margin="0,0,0,3" />
                    <TextBlock Grid.Column="6" Text="User" FontSize="11" Opacity="0.7" Margin="0,0,0,3" />
                    <TextBlock Grid.Column="8" Text="Password" FontSize="11" Opacity="0.7" Margin="0,0,0,3" />
                    <TextBox x:Name="SshNameBox" Grid.Row="1" Grid.Column="0" MaxLength="40"
                             ToolTip="A name to remember this device by, e.g. Office router" />
                    <TextBox x:Name="SshHostBox" Grid.Row="1" Grid.Column="2" />
                    <TextBox x:Name="SshPortBox" Grid.Row="1" Grid.Column="4" />
                    <TextBox x:Name="SshUserBox" Grid.Row="1" Grid.Column="6" />
                    <PasswordBox x:Name="SshPasswordBox" Grid.Row="1" Grid.Column="8" />
                    <Button Grid.Row="1" Grid.Column="10" Content="Connect" Padding="14,6" IsDefault="False"
                            ToolTip="Run ssh in the selected terminal tab" Click="SshConnect_Click" />
                </Grid>
                <DockPanel Margin="0,8,0,0">
                    <TextBlock DockPanel.Dock="Left" Text="Saved" FontSize="11" Opacity="0.7"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox x:Name="SshSavedBox" DockPanel.Dock="Left" Width="280" DisplayMemberPath="Label"
                              ToolTip="Saved connections" SelectionChanged="SshSavedBox_SelectionChanged" />
                    <Button DockPanel.Dock="Left" Content="Save" Margin="8,0,0,0" Click="SshSave_Click"
                            ToolTip="Save this name, host, port, user and password (the password is stored encrypted)" />
                    <Button DockPanel.Dock="Left" Content="Delete" Margin="8,0,0,0" Click="SshDelete_Click"
                            ToolTip="Delete the selected saved connection" />
                    <TextBlock x:Name="SshStatus" FontSize="11" Opacity="0.7" Margin="14,0,0,0"
                               VerticalAlignment="Center" TextWrapping="Wrap" />
                </DockPanel>
            </StackPanel>
            <Grid Background="#0C0C0C">
                <TextBlock x:Name="NoTerminalHint" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Opacity="0.6" Text="Open a workspace to start a PowerShell session." />
                <Grid x:Name="TerminalHost" />
            </Grid>
        </DockPanel>

        <!-- Column 2 for Markdown and LaTeX workspaces: file browser, editor and output -->
        <documents:DocumentPane x:Name="DocPane" Visibility="Collapsed" />

        <!-- Shown while the selected workspace loads its resources -->
        <Grid x:Name="LoadingOverlay" Background="#161616" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="320">
                <Ellipse Width="46" Height="46" StrokeThickness="4" Stroke="#46A758" StrokeDashArray="22 40"
                         StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5" Margin="0,0,0,18">
                    <Ellipse.RenderTransform>
                        <RotateTransform />
                    </Ellipse.RenderTransform>
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Style.Triggers>
                                <Trigger Property="IsVisible" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard x:Name="Spin">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(RotateTransform.Angle)"
                                                                 From="0" To="360" Duration="0:0:1" RepeatBehavior="Forever" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <StopStoryboard BeginStoryboardName="Spin" />
                                    </Trigger.ExitActions>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock x:Name="LoadingTitle" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock x:Name="LoadingStatus" FontSize="12" Opacity="0.7" HorizontalAlignment="Center"
                           TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0" />
            </StackPanel>
        </Grid>
            </Grid>
        </Grid>

        <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" Background="#22FFFFFF" />

        <!-- Column 3: transcriber, with a terminal underneath when a document workspace asks for one -->
        <Grid Grid.Column="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="200" />
                <RowDefinition x:Name="SideTerminalSplitterRow" Height="0" />
                <RowDefinition x:Name="SideTerminalRow" Height="0" />
            </Grid.RowDefinitions>
            <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" Background="#22FFFFFF" />
            <DockPanel x:Name="SideTerminalPanel" Grid.Row="2" Margin="10,0,10,10" Visibility="Collapsed">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="✕" FontSize="10"
                            ToolTip="Close the terminal" Click="SideTerminalClose_Click" />
                    <TextBlock Style="{StaticResource ColumnTitle}" Text="POWERSHELL" />
                </DockPanel>
                <Grid x:Name="SideTerminalHost" Background="#0C0C0C" />
            </DockPanel>

        <DockPanel Grid.Row="0" Margin="10">
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource ColumnTitle}" Text="READ ALOUD" Margin="0,0,0,8" />

            <TextBox x:Name="ReadAloudBox" DockPanel.Dock="Top" Height="96" AcceptsReturn="True"
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     ToolTip="Paste or type the text to read out loud" />

            <Grid DockPanel.Dock="Top" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="VoiceBox" Grid.Column="0" DisplayMemberPath="Label" HorizontalAlignment="Stretch"
                          ToolTip="Voice" SelectionChanged="Options_SelectionChanged" />
                <Button x:Name="ReadAloudButton" Grid.Column="2" Padding="14,6" Content="🔊  Read aloud"
                        Click="ReadAloudButton_Click" />
            </Grid>

            <TextBlock x:Name="ReadAloudStatus" DockPanel.Dock="Top" FontSize="11" Opacity="0.7" Margin="0,6,0,0"
                       TextWrapping="Wrap" Visibility="Collapsed" />

            <Separator DockPanel.Dock="Top" Margin="0,12" Opacity="0.4" />

            <TextBlock DockPanel.Dock="Top" Style="{StaticResource ColumnTitle}" Text="TRANSCRIBER" Margin="0,0,0,8" />

            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Language" FontSize="11" Opacity="0.7" Margin="0,0,0,3" />
                    <ComboBox x:Name="LanguageBox" DisplayMemberPath="Name" HorizontalAlignment="Stretch"
                              SelectionChanged="Options_SelectionChanged" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Model" FontSize="11" Opacity="0.7" Margin="0,0,0,3" />
                    <ComboBox x:Name="ModelBox" DisplayMemberPath="Name" HorizontalAlignment="Stretch"
                              SelectionChanged="Options_SelectionChanged" />
                </StackPanel>
            </Grid>

            <Button x:Name="MicButton" DockPanel.Dock="Top" HorizontalAlignment="Stretch" Padding="0,10"
                    FontSize="15" Content="🎤  Start dictation" Click="MicButton_Click" />

            <Button x:Name="FileButton" DockPanel.Dock="Top" HorizontalAlignment="Stretch" Padding="0,7"
                    Margin="0,8,0,0" Content="📂  Transcribe an audio file…" Click="FileButton_Click"
                    ToolTip="Play a recording (mp3, wav, m4a, wma, flac, WhatsApp ogg…) and transcribe it while it plays, like a dictation" />

            <TextBlock x:Name="StatusText" DockPanel.Dock="Top" FontSize="11" Opacity="0.7" Margin="0,6,0,0"
                       TextWrapping="Wrap" Text="Microphone off" />

            <!-- Shown while a file is being transcribed -->
            <StackPanel x:Name="ProgressPanel" DockPanel.Dock="Top" Margin="0,8,0,0" Visibility="Collapsed">
                <ProgressBar x:Name="TranscribeProgress" Height="10" Minimum="0" Maximum="1" />
                <DockPanel Margin="0,4,0,0">
                    <TextBlock x:Name="ProgressTimeText" DockPanel.Dock="Right" FontSize="11" Opacity="0.7"
                               Margin="8,0,0,0" />
                    <TextBlock x:Name="ProgressStageText" FontSize="11" Opacity="0.7"
                               TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </StackPanel>

            <Border x:Name="LivePanel" DockPanel.Dock="Top" Margin="0,8,0,0" Padding="10" CornerRadius="6"
                    BorderThickness="1" BorderBrush="#E5484D" Background="#22E5484D" Visibility="Collapsed">
                <ScrollViewer x:Name="LiveScroll" MaxHeight="220" VerticalScrollBarVisibility="Auto">
                    <TextBox x:Name="LiveText" Style="{StaticResource SelectableText}" />
                </ScrollViewer>
            </Border>

            <TextBlock x:Name="MarkdownPathText" DockPanel.Dock="Bottom" FontSize="11" Opacity="0.6"
                       Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />

            <TextBlock DockPanel.Dock="Top" FontSize="11" Opacity="0.7" Margin="0,12,0,4"
                       Text="Entries — click one to copy it, or select part of its text" />

            <ScrollViewer x:Name="EntriesScroll" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="EntriesList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Click="Entry_Click" HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch" Padding="10,8" Margin="0,0,0,6"
                                    Cursor="Hand" ToolTip="Click to copy">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="Copied ✓" FontSize="11"
                                                   Foreground="#46A758"
                                                   Visibility="{Binding IsCopied, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Text="{Binding Header}" FontSize="11" Opacity="0.6" />
                                    </DockPanel>
                                    <TextBox Text="{Binding Text, Mode=OneWay}" Style="{StaticResource SelectableText}"
                                             Margin="0,4,0,0" Cursor="IBeam"
                                             PreviewMouseLeftButtonUp="EntryText_MouseUp" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
        </Grid>
    </Grid>
</Window>
